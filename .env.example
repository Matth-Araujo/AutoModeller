KEY_MODELLER=coloque_sua_chave_do_modeller_aqui

# Django Settings
DJANGO_SECRET_KEY=django-insecure-sua-chave-secreta-para-ambiente-de-desenvolvimento
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Caminho opcional da instalação do Modeller (se diferente do padrão)
# MODINSTALL10v7=/usr/lib/modeller10.7
